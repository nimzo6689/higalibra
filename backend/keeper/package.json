{
  "name": "@higalibra/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm --filter @higalibra/scraping build && pnpm --filter @higalibra/push build && vite build && tsc --emitDeclarationOnly",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-secrets-manager": "^3.883.0",
    "@higalibra/push": "workspace:*",
    "@higalibra/scraping": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vite": "^6.1.0"
  }
}
